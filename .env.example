# Domaine de production, sans « / » final. Tant qu'il est absent,
# robots.txt bloque l'indexation et les URL canoniques pointent sur localhost.
NEXT_PUBLIC_SITE_URL=

# Envoi des demandes de devis (https://resend.com)
RESEND_API_KEY=
# Destinataire(s), séparés par des virgules
QUOTE_TO_EMAIL=
# Expéditeur sur un domaine vérifié dans Resend
QUOTE_FROM_EMAIL="Site Engine House <devis@votre-domaine.ma>"
